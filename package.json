{
	"name": "browsdr",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:aircraft-db": "python scripts/aircraft-db/build.py --output public/aircraft-db",
		"publish:aircraft-db": "node scripts/aircraft-db/publish.mjs",
		"dev:worker": "wrangler dev --port 8788 --test-scheduled",
		"types:worker": "wrangler types types/worker.d.ts --env-interface BrowSdrWorkerEnv",
		"test:aircraft-db": "python -m unittest discover -s test/aircraft-db -p test_*.py",
		"build:dsp": "wasm-pack build wasm/dsp --target web --out-dir pkg",
		"build:dsp:node": "wasm-pack build wasm/dsp --target nodejs --out-dir node",
		"test:dsp:bindings": "npm run build:dsp:node && node wasm/dsp/test-js-binding.mjs",
		"build:mbelib": "bash wasm/mbelib/build.sh",
		"build:rtl433": "node scripts/update-rtl433.mjs --build",
		"check:rtl433": "node scripts/update-rtl433.mjs --check",
		"update:rtl433": "node scripts/update-rtl433.mjs",
		"deploy": "vite build && wrangler deploy",
		"dev": "vite",
		"start": "vite",
		"test": "vitest",
		"test:dsp": "cargo test --manifest-path wasm/dsp/Cargo.toml",
		"test:ui": "vitest run --config vitest.ui.config.ts",
		"test:performance": "vitest run test/ui/vfo-performance.spec.ts test/streams/shared-vfo-stream.spec.js",
		"test:storybook": "vitest run --config vitest.storybook.config.ts",
		"storybook": "storybook dev -p 6006 --disable-telemetry",
		"build:storybook": "storybook build --disable-telemetry",
		"typecheck": "tsc --noEmit && tsc --noEmit --project src/server/tsconfig.json",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"check:structure": "node scripts/check-structure.mjs",
		"check": "npm run lint && npm run format:check && npm run check:structure && npm run typecheck && npm run test:dsp"
	},
	"dependencies": {
		"comlink": "^4.4.2",
		"leaflet": "^1.9.4",
		"peerjs": "^1.5.5",
		"vue": "^3.5.29"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/vue3-vite": "^10.6.1",
		"@types/jsdom": "^21.1.7",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^22.20.5",
		"@vitest/browser": "^3.2.7",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"jsdom": "^26.1.0",
		"playwright": "^1.58.2",
		"prettier": "^3.9.9",
		"storybook": "^10.6.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^6.4.1",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "~3.2.7",
		"wrangler": "^4.69.0"
	},
	"engines": {
		"node": "^22.13.0 || >=24"
	}
}
